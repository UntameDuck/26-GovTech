# 로컬 개발 (docker-compose.yml 의 postgres 서비스와 일치)
#
# 호스트를 localhost 가 아니라 127.0.0.1 로 쓴다.
# Windows + Docker Desktop 환경에서 localhost 는 IPv6(::1) 로 먼저 풀리는데,
# WSL relay 가 남아 있으면 그쪽으로 붙어 ECONNRESET 이 난다.
# IPv4 로 고정하면 Docker 가 연 포트로 확실히 간다.
DATABASE_URL="postgresql://aureum:aureum_local_dev@127.0.0.1:5433/aureum?schema=public"

# Public Renderer 가 Host 헤더로 Site 를 찾지 못했을 때 쓰는 기본 사이트 slug.
# 로컬에서 school-a.localhost 같은 호스트를 매번 설정하지 않아도 되게 한다.
DEFAULT_SITE_SLUG="demo-school"

# 관리자 콘솔 접속 호스트. 이 호스트로 들어온 요청은 Site lookup 을 하지 않는다.
ADMIN_HOST="localhost"

# Auth.js 세션 서명 키.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 공개 접속 주소. K-PaaS Ingress 뒤에 배포할 때 실제 도메인으로 고정한다.
# 비워 두면 Auth.js 가 요청의 Host 헤더로 추론한다(auth.config.ts 의 trustHost 참고).
# AUTH_URL="https://school.example.kr"

# 개발용 시드 계정의 비밀번호. 비워 두면 시드 실행 때마다 새로 생성해 출력한다.
# SEED_PASSWORD=""
